HOST=127.0.0.1
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Vacío = zona horaria del sistema donde corre Node. Puedes escribir una zona IANA.
APP_TIME_ZONE=
