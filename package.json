{
  "name": "torneo-express-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.x",
    "npm": "11.19.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "auth:hash": "node scripts/hash-password.js",
    "test": "node --test tests/unit/*.test.js tests/http/*.test.js",
    "test:mysql": "node --env-file=.env.test --test tests/integration/mysql.test.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.24.4",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.0.0"
  }
}
